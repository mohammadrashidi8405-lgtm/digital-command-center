# Digital Command Center — environment variables
# Copy this file to .env and fill in real values. .env is gitignored — it
# never leaves this machine and is never committed.

# Required for the Claude Brain provider (config/config.json -> brain.provider = "claude").
# Get a key at https://console.anthropic.com/settings/keys
# Without this set, the Claude Brain provider automatically falls back to
# the honest file-drop brain (core/brain/claude-brain.mjs) — nothing breaks,
# nothing is faked. See docs/SETUP.md.
ANTHROPIC_API_KEY=
